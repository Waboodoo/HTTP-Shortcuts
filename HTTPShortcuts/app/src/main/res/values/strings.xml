<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The name of the app -->
    <string name="app_name">Restore Shortcuts</string>
    <!-- The name of the default category -->
    <string name="shortcuts">Shortcuts</string>
    <!-- Generic dialog button: OK -->
    <string name="dialog_ok">OK</string>
    <!-- Error message: Shown in dialog when import of shortcuts & variables failed. %s is a placeholder for a message describing the reason for the failure -->
    <string name="import_failed_with_reason">Importing shortcuts failed:\n%s</string>
    <!-- Error message: Import failed due to invalid JSON syntax in the import file -->
    <string name="import_failure_reason_invalid_json">Invalid JSON</string>
    <!-- Error message: Import failed due to the data being imported coming from a newer version of the app -->
    <string name="import_failure_reason_data_version_mismatch">The selected file was exported by a newer version of the app and can not be imported.</string>
    <!-- Success message, shown in snackbar when import of shortcuts is successful -->
    <plurals name="shortcut_import_success">
        <item quantity="one">1 shortcut imported.</item>
        <item quantity="other">%d shortcuts imported.</item>
    </plurals>
    <!-- Generic error shown when an action fails because the device does not support it, e.g. importing from another app -->
    <string name="error_not_supported">This feature is not supported on your device.</string>
    <!-- Generic error shown when something went wrong and there is no better error message available -->
    <string name="error_generic">An unexpected error has occurred.</string>
    <!-- Dialog title: shown on import dialog, e.g. when a password needs to be entered -->
    <string name="dialog_title_import">Import</string>
    <!-- Dialog text: Asks user to enter a password to import password-encrypted data into the app -->
    <string name="dialog_text_import_with_password">This import requires a password.</string>
    <!-- Dialog text: Asks user to enter the password to import password-encrypted data into the app, after an incorrect try -->
    <string name="dialog_text_import_with_password_retry">Wrong password. Please try again.</string>
    <!-- Empty state instructions, shown in the editor for variable widgets when the user hasn't created any global variables of type "Static Variable" yet. -->
    <string name="import_instructions">This app can be used to restore shortcuts from an old version of HTTP Shortcuts.\n\nVisit https://http-shortcuts.rmy.ch/restore for instructions.</string>
    <string name="import_in_progress">Importing…</string>
    <string name="export_in_progress">Exporting…</string>
    <string name="import_from_file">Import from File</string>
    <string name="export_to_file">Export to File</string>
    <string name="export_success">Successfully exported.</string>
</resources>
